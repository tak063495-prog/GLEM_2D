<Window x:Class="GLEM.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GLEM.App.Converters"
        xmlns:loc="clr-namespace:GLEM.App.Localization"
        xmlns:views="clr-namespace:GLEM.App.Views"
        Title="GLEM" Height="720" Width="1080"
        Closing="Window_Closing">
    <Window.Resources>
        <conv:ScreenMatchConverter x:Key="ScreenMatch"/>
    </Window.Resources>
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{loc:Loc Key='Menu_File'}">
                <MenuItem Header="{loc:Loc Key='Menu_New'}" Command="{Binding NewProjectCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc Key='Menu_Open'}" Command="{Binding RequestOpenCommand}"/>
                <MenuItem Header="{loc:Loc Key='Menu_Save'}" Command="{Binding SaveCommand}"/>
                <MenuItem Header="{loc:Loc Key='Menu_SaveAs'}" Command="{Binding RequestSaveAsCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key='Menu_Language'}">
                <MenuItem x:Name="LanguageSystemMenuItem" IsCheckable="True" Tag="System" Click="Language_Click"
                          Header="{loc:Loc Key='Menu_LanguageSystem'}"/>
                <MenuItem x:Name="LanguageEnglishMenuItem" IsCheckable="True" Tag="English" Click="Language_Click"
                          Header="{loc:Loc Key='Menu_LanguageEnglish'}"/>
                <MenuItem x:Name="LanguageJapaneseMenuItem" IsCheckable="True" Tag="Japanese" Click="Language_Click"
                          Header="{loc:Loc Key='Menu_LanguageJapanese'}"/>
            </MenuItem>
            <MenuItem Header="{loc:Loc Key='Menu_Help'}">
                <MenuItem Header="{loc:Loc Key='Menu_About'}" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation (S-1) -->
            <StackPanel Grid.Column="0" Margin="8">
                <TextBlock Text="GLEM" FontSize="20" FontWeight="Bold" Margin="4,4,4,12"/>
                <Button Content="{loc:Loc Key='Nav_GroundModel'}" Height="34" Margin="0,2" Padding="6"
                        Command="{Binding NavigateCommand}" CommandParameter="GroundModel"/>
                <Button Content="{loc:Loc Key='Nav_SlopeSettings'}" Height="34" Margin="0,2" Padding="6"
                        Command="{Binding NavigateCommand}" CommandParameter="SlopeSettings"/>
                <Button Content="{loc:Loc Key='Nav_SlopeResults'}" Height="34" Margin="0,2" Padding="6"
                        Command="{Binding NavigateCommand}" CommandParameter="SlopeResult"/>
                <Separator Margin="0,8"/>
                <Button Content="{loc:Loc Key='Nav_SettlementSettings'}" Height="34" Margin="0,2" Padding="6"
                        Command="{Binding NavigateCommand}" CommandParameter="SettlementSettings"/>
                <Button Content="{loc:Loc Key='Nav_SettlementResults'}" Height="34" Margin="0,2" Padding="6"
                        Command="{Binding NavigateCommand}" CommandParameter="SettlementResult"/>
                <Separator Margin="0,8"/>
                <TextBlock Text="{Binding Project.ProjectName}" Margin="4,8,4,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentFilePath, TargetNullValue={loc:Loc Key='Nav_Unsaved'}}"
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="4,2,4,0"/>
            </StackPanel>

            <!-- Screen content (S-2 to S-6) -->
            <Grid Grid.Column="1">
                <views:GroundModelEditorView DataContext="{Binding GroundModelEditor}" Visibility="{Binding DataContext.ActiveScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScreenMatch}, ConverterParameter=GroundModel}"/>
                <views:SlopeAnalysisSettingsView DataContext="{Binding SlopeAnalysis}" Visibility="{Binding DataContext.ActiveScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScreenMatch}, ConverterParameter=SlopeSettings}"/>
                <views:SlopeResultView DataContext="{Binding SlopeAnalysis}" Visibility="{Binding DataContext.ActiveScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScreenMatch}, ConverterParameter=SlopeResult}"/>
                <views:SettlementSettingsView DataContext="{Binding Settlement}" Visibility="{Binding DataContext.ActiveScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScreenMatch}, ConverterParameter=SettlementSettings}"/>
                <views:SettlementResultView DataContext="{Binding Settlement}" Visibility="{Binding DataContext.ActiveScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ScreenMatch}, ConverterParameter=SettlementResult}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
