<UserControl x:Class="GLEM.App.Views.SlopeAnalysisSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Slope Stability Analysis (S-3)" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- 手法選択 -->
            <GroupBox Header="Analysis Method" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton Content="Bishop simplified method (circular)" IsChecked="{Binding MethodIsBishop}" GroupName="Method"/>
                    <RadioButton Content="Fellenius method (circular)" IsChecked="{Binding MethodIsFellenius}" GroupName="Method" Margin="0,4,0,0"/>
                    <RadioButton Content="Janbu generalized wedge method (non-circular)" IsChecked="{Binding MethodIsJanbu}" GroupName="Method" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Slip surface control points (Janbu non-circular, C-04) -->
            <GroupBox Header="Slip Surface Control Points (shown when Janbu is selected)" Padding="8" Margin="0,0,0,10"
                      Visibility="{Binding MethodIsJanbu, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="+ Add Point" Width="100" Height="28" Command="{Binding AddControlPointCommand}"/>
                        <Button Content="- Remove Selected" Width="130" Height="28" Margin="8,0,0,0" Command="{Binding RemoveSelectedControlPointCommand}"/>
                        <TextBlock Text="  (3 or more points required)" VerticalAlignment="Center" Foreground="#567" FontSize="11"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ControlPoints}" SelectedItem="{Binding SelectedControlPoint}"
                              AutoGenerateColumns="False" CanUserAddRows="False" Height="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="x [m]" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="z [m] (depth below surface)" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- Basic parameters -->
            <GroupBox Header="Parameters" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Slice width [m]:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="Width of each slice for discretization [m]"
                             Text="{Binding SliceWidthM, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Surcharge q [kPa]:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="Uniform surcharge load [kPa]"
                             Text="{Binding SurchargeKpa, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="8,6" IsChecked="{Binding HasSurchargeRange}"
                              Content="Apply over range x:"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center"
                                 Text="{Binding SurchargeStartX, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" to " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center"
                                 Text="{Binding SurchargeEndX, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Seismic coefficients:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBlock Text="kh = " VerticalAlignment="Center"/>
                        <TextBox Width="70" Height="24" VerticalContentAlignment="Center" ToolTip="Horizontal seismic coefficient [-]"
                                 Text="{Binding Kh, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="  kv = " VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Width="70" Height="24" VerticalContentAlignment="Center" ToolTip="Vertical seismic coefficient [-]"
                                 Text="{Binding Kv, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Search range:" VerticalAlignment="Center"/>
                    <RadioButton Grid.Row="5" Grid.Column="1" Margin="8,4" Content="Automatic (recommended)" IsChecked="{Binding AutoSearch}"/>
                </Grid>
            </GroupBox>

            <!-- 手動探索範囲 -->
            <GroupBox Header="Manual Search Range (circle center &amp; radius)" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="cx [m]:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" Text="{Binding CxMin, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" to " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" Text="{Binding CxMax, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="cz [m]:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" Text="{Binding CzMin, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" to " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" Text="{Binding CzMax, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="R [m]:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" Text="{Binding RadiusMin, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" to " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" Text="{Binding RadiusMax, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 実行 -->
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}"/>
                <Button DockPanel.Dock="Left" Content="Run Analysis" Width="140" Height="34"
                        Command="{Binding RunCommand}"/>
                <StackPanel Margin="12,0,0,0">
                    <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#445" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding RunError}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
