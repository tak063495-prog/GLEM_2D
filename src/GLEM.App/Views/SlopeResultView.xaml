<UserControl x:Class="GLEM.App.Views.SlopeResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel Margin="12">
        <!-- 結果ヘッダ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                <Run Text="Minimum safety factor FS = "/><Run Text="{Binding Result.MinFs, Mode=OneWay, StringFormat=F3}"/>
            </TextBlock>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center">
                <Run Text="Method: "/><Run Text="{Binding Result.Method, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center">
                <Run Text="Converged: "/><Run Text="{Binding Result.Converged, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- 出力 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Export CSV..." Width="120" Height="30" Click="ExportCsv_Click"/>
            <Button Content="Generate Report..." Width="140" Height="30" Margin="8,0,0,0" Click="Report_Click"/>
        </StackPanel>

        <!-- 断面図 -->
        <sp:WpfPlot x:Name="CrossSectionPlot" DockPanel.Dock="Top" Height="360" Margin="0,0,0,8"/>

        <!-- 条体別結果テーブル -->
        <DataGrid ItemsSource="{Binding Result.Slices}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="slice_no" Binding="{Binding SliceNo}"/>
                <DataGridTextColumn Header="x [m]" Binding="{Binding X, StringFormat=F3}"/>
                <DataGridTextColumn Header="z [m]" Binding="{Binding Z, StringFormat=F3}"/>
                <DataGridTextColumn Header="W [kN/m]" Binding="{Binding WKnPerM, StringFormat=F2}"/>
                <DataGridTextColumn Header="alpha [deg]" Binding="{Binding AlphaDeg, StringFormat=F2}"/>
                <DataGridTextColumn Header="u [kPa]" Binding="{Binding UKpa, StringFormat=F2}"/>
                <DataGridTextColumn Header="N'p [kN/m]" Binding="{Binding NpKnPerM, StringFormat=F2}"/>
                <DataGridTextColumn Header="c term [kN/m]" Binding="{Binding CTermKnPerM, StringFormat=F2}"/>
                <DataGridTextColumn Header="phi term [kN/m]" Binding="{Binding PhiTermKnPerM, StringFormat=F2}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
