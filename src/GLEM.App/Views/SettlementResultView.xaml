<UserControl x:Class="GLEM.App.Views.SettlementResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel Margin="12">
        <!-- 結果ヘッダ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                <Run Text="Total settlement: "/><Run Text="{Binding Result.TotalMm, Mode=OneWay, StringFormat=F2}"/><Run Text=" mm"/>
            </TextBlock>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center">
                <Run Text="(Immediate "/><Run Text="{Binding Result.ImmediateMm, Mode=OneWay, StringFormat=F2}"/>
                <Run Text=" + Primary "/><Run Text="{Binding Result.PrimaryMm, Mode=OneWay, StringFormat=F2}"/>
                <Run Text=" + Secondary "/><Run Text="{Binding Result.SecondaryMm, Mode=OneWay, StringFormat=F2}"/><Run Text=")"/>
            </TextBlock>
        </StackPanel>

        <!-- T50/T90 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="#EEF3FA" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                <TextBlock>
                    <Run Text="T50 = "/><Run Text="{Binding Result.T50Days, Mode=OneWay, StringFormat=F1}"/><Run Text=" days"/>
                </TextBlock>
            </Border>
            <Border Background="#EEF3FA" CornerRadius="4" Padding="10,6">
                <TextBlock>
                    <Run Text="T90 = "/><Run Text="{Binding Result.T90Days, Mode=OneWay, StringFormat=F1}"/><Run Text=" days"/>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- 出力 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Export CSV..." Width="120" Height="30" Click="ExportCsv_Click"/>
            <Button Content="Generate Report..." Width="140" Height="30" Margin="8,0,0,0" Click="Report_Click"/>
        </DockPanel>

        <!-- 軸切替 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="LinearAxisButton" Content="Linear time axis" Width="120" Height="26" Click="LinearAxis_Click"/>
            <Button x:Name="LogAxisButton" Content="Logarithmic time axis" Width="140" Height="26" Margin="8,0,0,0" Click="LogAxis_Click"/>
            <TextBlock x:Name="CursorReadout" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#334"/>
        </StackPanel>

        <!-- S-t グラフ -->
        <sp:WpfPlot x:Name="StPlot" MouseMove="StPlot_MouseMove"/>

        <!-- 内訳テーブル -->
        <DataGrid ItemsSource="{Binding Result.TimeSeries}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All" Height="180" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="time [day]" Binding="{Binding TimeDays, StringFormat=F2}"/>
                <DataGridTextColumn Header="U [%]" Binding="{Binding UPercent, StringFormat=F2}"/>
                <DataGridTextColumn Header="S [mm]" Binding="{Binding SettlementMm, StringFormat=F2}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
