<UserControl x:Class="GLEM.App.Views.SettlementSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GLEM.App.Localization"
             xmlns:conv="clr-namespace:GLEM.App.Converters">
    <UserControl.Resources>
        <conv:DrainageDisplayConverter x:Key="DrainageDisplay"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Key='SettlementSettings_Title'}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <GroupBox Header="{loc:Loc Key='SettlementSettings_LoadingGroup'}" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc Key='SettlementSettings_LoadLabel'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="{loc:Loc Key='SettlementSettings_LoadTooltip'}"
                             Text="{Binding LoadKpa, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Text="{loc:Loc Key='SettlementSettings_AreaLabel'}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" ToolTip="{loc:Loc Key='SettlementSettings_AreaBTooltip'}"
                                 Text="{Binding LoadedAreaB, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" x " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" ToolTip="{loc:Loc Key='SettlementSettings_AreaLTooltip'}"
                                 Text="{Binding LoadedAreaL, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="{loc:Loc Key='SettlementSettings_ConsolidationGroup'}" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Loc Key='SettlementSettings_DrainageLabel'}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="8,4"
                              ItemsSource="{Binding DrainageOptions}" SelectedItem="{Binding DrainageMode}">
                        <!-- 表示のみをローカライズ。SelectedItem は引き続き Drainage のまま -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DrainageDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="{loc:Loc Key='SettlementSettings_DurationLabel'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="{loc:Loc Key='SettlementSettings_DurationTooltip'}"
                             Text="{Binding DurationYears, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Text="{loc:Loc Key='SettlementSettings_OutputPointsLabel'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="{loc:Loc Key='SettlementSettings_OutputPointsTooltip'}"
                             Text="{Binding OutputPointCount, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <DockPanel Margin="0,8,0,0">
                <Button Content="{loc:Loc Key='SettlementSettings_RunButton'}" Width="140" Height="34" Command="{Binding RunCommand}"/>
                <TextBlock Text="{Binding RunError}" Foreground="#B00020" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
