<UserControl x:Class="GLEM.App.Views.SettlementSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settlement Prediction (S-5)" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <GroupBox Header="Loading" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Applied load [kPa]:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="Additional vertical stress applied to the ground [kPa]"
                             Text="{Binding LoadKpa, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Text="Loaded area B x L [m]:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" ToolTip="Width of the loaded rectangular area [m]"
                                 Text="{Binding LoadedAreaB, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text=" x " VerticalAlignment="Center" Margin="6,0"/>
                        <TextBox Width="90" Height="24" VerticalContentAlignment="Center" ToolTip="Length of the loaded rectangular area [m]"
                                 Text="{Binding LoadedAreaL, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Consolidation" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Drainage condition:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="8,4"
                              ItemsSource="{Binding DrainageOptions}" SelectedItem="{Binding DrainageMode}"/>

                    <TextBlock Grid.Row="1" Text="Analysis duration [years]:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="Duration of the settlement-time analysis [years]"
                             Text="{Binding DurationYears, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Text="Output points:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="8,4" Height="24"
                             VerticalContentAlignment="Center" ToolTip="Number of output points for the S-t curve (2-1000)"
                             Text="{Binding OutputPointCount, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <DockPanel Margin="0,8,0,0">
                <Button Content="Run Analysis" Width="140" Height="34" Command="{Binding RunCommand}"/>
                <TextBlock Text="{Binding RunError}" Foreground="#B00020" TextWrapping="Wrap" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
