<UserControl x:Class="GLEM.App.Views.GroundModelEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GLEM.App.Converters">
    <UserControl.Resources>
        <conv:FieldInSetConverter x:Key="FieldInSet"/>
        <conv:BoolToBorderConverter x:Key="BoolToBorder"/>
        <Style x:Key="ErrorCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorFields, Converter={StaticResource FieldInSet}, ConverterParameter=thickness_m}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorFields, Converter={StaticResource FieldInSet}, ConverterParameter=gamma_kn_m3}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorFields, Converter={StaticResource FieldInSet}, ConverterParameter=c_kpa}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorFields, Converter={StaticResource FieldInSet}, ConverterParameter=phi_deg}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorFields, Converter={StaticResource FieldInSet}, ConverterParameter=ru_ratio}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- Groundwater level -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Groundwater level depth [m]:" VerticalAlignment="Center"/>
            <TextBox Width="80" Margin="8,0" Height="24" VerticalContentAlignment="Center"
                     Text="{Binding WaterTableDepthM, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Depth of the groundwater table below the ground surface [m]"
                     BorderBrush="{Binding HasWaterTableError, Converter={StaticResource BoolToBorder}}"/>
        </StackPanel>

        <!-- Validation result -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Run Validation" Width="120" Height="30" DockPanel.Dock="Left"
                    Command="{Binding RunValidationCommand}"/>
            <TextBlock Text="{Binding ValidationSummary}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextWrapping="Wrap" Foreground="#B00020"/>
        </DockPanel>

        <!-- Layer operations -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+ Add Layer" Width="100" Height="28" Command="{Binding AddLayerCommand}"/>
            <Button Content="- Remove Selected" Width="130" Height="28" Margin="6,0,0,0" Command="{Binding RemoveSelectedCommand}"/>
            <Button Content="Up" Width="40" Height="28" Margin="6,0,0,0" Command="{Binding MoveUpCommand}"/>
            <Button Content="Down" Width="50" Height="28" Margin="6,0,0,0" Command="{Binding MoveDownCommand}"/>
        </StackPanel>

        <!-- Layer table -->
        <DataGrid ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  CellStyle="{StaticResource ErrorCellStyle}" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No." Binding="{Binding Index, Mode=OneTime}" Width="40"/>
                <DataGridTextColumn Header="Layer Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="Thickness [m]" Binding="{Binding ThicknessM, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="&#373; [kN/m&#179;]" Binding="{Binding GammaKnm3, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="c' [kPa]" Binding="{Binding CohesionKpa, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="&#966;' [&#176;]" Binding="{Binding FrictionAngleDeg, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="k [m/s]" Binding="{Binding PermeabilityMs, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="e0" Binding="{Binding InitialVoidRatio, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Cc" Binding="{Binding CompressionIndexCc, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Cr" Binding="{Binding RecompressionIndexCr, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="&#963;p [kPa]" Binding="{Binding PreconsolidationPressureKpa, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Cs" Binding="{Binding SecondaryCompressionIndexCs, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Es [kPa]" Binding="{Binding ElasticModulusKpa, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="&#180;" Binding="{Binding PoissonRatio, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="ru" Binding="{Binding RuRatio, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
